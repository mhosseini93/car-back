# Copy to .env and adjust
PORT=4000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://car_app:password@localhost:5432/car

# Secret for signing admin tokens (long random string)
JWT_SECRET=change-me

# Admin login. Generate the hash with: npm run admin:hash -- "<password>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
